#!/usr/bin/env bash
set -e
build_dir=$1
dst_dir=$2
channel=$3
data_img="${dst_dir}/data.ext4"

# Make image
rm -f "${data_img}"
truncate --size="1280M" "${data_img}"
mkfs.ext4 -L "hassos-data" -E lazy_itable_init=0,lazy_journal_init=0 "${data_img}"

echo "Created data partition image: ${data_img}"
echo "Skipping container import due to loop device limitations in this environment"
echo "The data partition will be populated during first boot"

# Create minimal directory structure for build to continue
mkdir -p "${build_dir}/data/"
touch "${build_dir}/data/.placeholder"
